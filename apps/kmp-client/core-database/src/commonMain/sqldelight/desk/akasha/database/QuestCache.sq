CREATE TABLE quest_cache (
  id TEXT NOT NULL PRIMARY KEY,
  type TEXT NOT NULL,
  title TEXT NOT NULL,
  hp_delta INTEGER NOT NULL DEFAULT 0,
  xp_delta INTEGER NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'pending',
  updated_at_epoch_ms INTEGER NOT NULL
);

selectAll:
SELECT *
FROM quest_cache
ORDER BY updated_at_epoch_ms DESC;

selectById:
SELECT *
FROM quest_cache
WHERE id = ?;

upsert:
INSERT OR REPLACE INTO quest_cache(
  id,
  type,
  title,
  hp_delta,
  xp_delta,
  sync_state,
  updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM quest_cache
WHERE id = ?;

